@host = http://localhost:8080
@accessToken = {{login.response.body.data.accessToken}}

### Login
# @name login
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "loginId": "admin",
  "password": "admin"
}

### List GMS prompts
GET {{host}}/api/v1/backoffice/gms/prompts?featureType=fortune&status=all&page=0&size=20
Authorization: Bearer {{accessToken}}

### List active GMS prompts
GET {{host}}/api/v1/backoffice/gms/prompts?featureType=fortune&status=active&page=0&size=20
Authorization: Bearer {{accessToken}}

### Get current fortune prompt
GET {{host}}/api/v1/backoffice/gms/prompts/current?featureType=fortune
Authorization: Bearer {{accessToken}}

### Create GMS prompt
POST {{host}}/api/v1/backoffice/gms/prompts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "오늘의 운세 v2",
  "content": "프론트엔드 만세력 결과를 바탕으로 오늘의 운세를 JSON으로 생성해줘.",
  "featureType": "fortune"
}

### Activate GMS prompt
POST {{host}}/api/v1/backoffice/gms/prompts/1/activate
Authorization: Bearer {{accessToken}}

### Test saved GMS prompt
POST {{host}}/api/v1/backoffice/gms/prompts/1/test
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "sampleSaju": {
    "calendarType": "solar",
    "yearPillar": "갑자",
    "monthPillar": "병인",
    "dayPillar": "무진",
    "hourPillar": "경오",
    "dayMasterElement": "wood",
    "dayBranchElement": "earth",
    "dayMasterYinYang": "yang",
    "dayBranchYinYang": "yang"
  }
}

### Preview unsaved GMS prompt
POST {{host}}/api/v1/backoffice/gms/prompts/preview
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "featureType": "fortune",
  "content": "후보 프롬프트 본문",
  "sampleSaju": {
    "calendarType": "solar",
    "yearPillar": "갑자",
    "monthPillar": "병인",
    "dayPillar": "무진",
    "hourPillar": "경오",
    "dayMasterElement": "wood",
    "dayBranchElement": "earth",
    "dayMasterYinYang": "yang",
    "dayBranchYinYang": "yang"
  }
}
