@host = http://localhost:8080
@adminAccessToken = replace-with-admin-access-token

### Admin metrics query - service_up_status (Prometheus 자체 up)
POST {{host}}/api/v1/admin/metrics/query
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "template": "service_up_status",
  "params": {
    "job": "prometheus"
  }
}

### Admin metrics query - service_up_status (Spring 앱 up)
POST {{host}}/api/v1/admin/metrics/query
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "template": "service_up_status",
  "params": {
    "job": "spring-app"
  }
}

