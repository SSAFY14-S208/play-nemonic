@host = http://localhost:8080

### Admin login
POST {{host}}/api/v1/auth/login
Content-Type: application/json
X-Trace-Id: auth-login-local

{
  "loginId": "admin",
  "password": "password"
}

> {% client.global.set("adminAccessToken", response.body.data.accessToken); %}
> {% client.global.set("adminRefreshToken", response.body.data.refreshToken); %}

### Admin logout
POST {{host}}/api/v1/auth/logout
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
X-Trace-Id: auth-logout-local

{
  "refreshToken": "{{adminRefreshToken}}"
}

### Reissue admin token
POST {{host}}/api/v1/auth/reissue
Content-Type: application/json

{
  "refreshToken": "{{adminRefreshToken}}"
}

> {% client.global.set("adminAccessToken", response.body.data.accessToken); %}
> {% client.global.set("adminRefreshToken", response.body.data.refreshToken); %}

### Create admin account
POST {{host}}/api/v1/admins
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "loginId": "manager01",
  "password": "Password123!",
  "nickname": "Operator",
  "email": "manager01@example.com"
}

### List admins
GET {{host}}/api/v1/admins
Authorization: Bearer {{adminAccessToken}}

### Change admin password
PATCH {{host}}/api/v1/admins/2
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "password": "Changed123!"
}

### Admin account detail
GET {{host}}/api/v1/admins/2
Authorization: Bearer {{adminAccessToken}}

### Delete admin account
DELETE {{host}}/api/v1/admins/2
Authorization: Bearer {{adminAccessToken}}
