@host = http://localhost:8080

### Admin login
POST {{host}}/api/v1/auth/admin/login
Content-Type: application/json
X-Trace-Id: auth-login-local

{
  "loginId": "admin",
  "password": "password"
}

> {% client.global.set("adminAccessToken", response.body.data.accessToken); %}

### Current admin
GET {{host}}/api/v1/auth/admin/me
Authorization: Bearer {{adminAccessToken}}

### Create admin account
POST {{host}}/api/v1/admin/accounts
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "loginId": "manager01",
  "password": "Password123!",
  "nickname": "운영자",
  "email": "manager01@example.com"
}

### Admin logout
POST {{host}}/api/v1/auth/admin/logout
Authorization: Bearer {{adminAccessToken}}
X-Trace-Id: auth-logout-local
