@host = http://localhost:8080

### Admin login
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "loginId": "admin",
  "password": "password"
}

> {% client.global.set("adminAccessToken", response.body.data.accessToken); %}

### List active flipbook rooms
GET {{host}}/api/v1/backoffice/flipbook-rooms
Authorization: Bearer {{adminAccessToken}}

### List active flipbook rooms - status filter
GET {{host}}/api/v1/backoffice/flipbook-rooms?status=PLAYING&page=0&size=20
Authorization: Bearer {{adminAccessToken}}

### List active flipbook rooms - invalid status
GET {{host}}/api/v1/backoffice/flipbook-rooms?status=CLOSED
Authorization: Bearer {{adminAccessToken}}
