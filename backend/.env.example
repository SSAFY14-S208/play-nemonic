DB_URL=jdbc:postgresql://localhost:5432/nemonic_local
DB_NAME=nemonic_local
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SERVER_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=your_minio_bucket
MINIO_PRESIGN_EXPIRATION_MINUTES=10
MINIO_VIEW_URL_EXPIRATION_MINUTES=1440
COMMUNITY_MODERATION_ENABLED=true
COMMUNITY_MODERATION_BASE_URL=http://localhost:8000
COMMUNITY_MODERATION_CHECK_PATH=/check
COMMUNITY_MODERATION_CONNECT_TIMEOUT_MS=1000
COMMUNITY_MODERATION_READ_TIMEOUT_MS=3000
COMMUNITY_MODERATION_FAIL_CLOSED=false
GMS_API_KEY=
GMS_MODEL=gpt-5.2
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
GMS_CONNECT_TIMEOUT_MS=3000
GMS_READ_TIMEOUT_MS=30000
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_JWT_ACCESS_TOKEN_EXPIRATION=30m
ADMIN_JWT_REFRESH_TOKEN_EXPIRATION=14d

# 선택: 최초 슈퍼 관리자 1회 생성용. 생성 후 false로 되돌리거나 제거하세요.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN_ID=your_admin_login_id
ADMIN_BOOTSTRAP_PASSWORD=replace_with_initial_password
ADMIN_BOOTSTRAP_NICKNAME=your_admin_nickname
ADMIN_BOOTSTRAP_EMAIL=your_admin_email@example.com

# 선택: 고객 문의 회신 SMTP 설정
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
# 비워두면 MAIL_USERNAME을 발신자로 사용합니다.
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# 선택: 클라이언트 로그 ingest 보안 설정
CLIENT_LOG_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLIENT_LOG_MAX_EVENTS_PER_REQUEST=200
CLIENT_LOG_MAX_PAYLOAD_BYTES=1048576
CLIENT_LOG_RATE_LIMIT_EVENTS_PER_SECOND=100
CLIENT_LOG_RATE_LIMIT_EVENTS_PER_MINUTE=1000

# 선택: Flyway 자동 실행 차단 (운영 DB 디버깅 시 .env.server에서 false로 설정 권장)
# FLYWAY_ENABLED=true
