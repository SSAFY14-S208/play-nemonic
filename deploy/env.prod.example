# ============================================================
# Production Environment Variables
# 실제 사용 시 이 파일을 .env.prod로 복사하고 값 채우기
# 절대 Git에 커밋하지 말 것!
# ============================================================

# 도메인
DOMAIN=k14s208.p.ssafy.io

# Compose 프로젝트 이름
COMPOSE_PROJECT_NAME=nemonic-prod

# ============================================================
# PostgreSQL
# ============================================================
DB_NAME=nemonic_prod
DB_USERNAME=nemonic
# 최소 16자 이상, 대소문자/숫자/특수문자 혼합 권장
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================
# Redis
# ============================================================
# 최소 16자 이상 권장
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================================
# MinIO
# ============================================================
# Access Key (username 역할) - 3자 이상
MINIO_ROOT_USER=minio_admin
# Secret Key (password 역할) - 8자 이상
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# 기본 버킷 이름
MINIO_BUCKET=nemonic

# ============================================================
# Spring Boot
# ============================================================
SERVER_PORT=8080
