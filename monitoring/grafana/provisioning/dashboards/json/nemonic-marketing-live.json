      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:client_alive AND NOT path:/admin\\/*",
          "alias": "{{term path}}",
          "metrics": [ { "type": "cardinality", "field": "uuid", "id": "1" } ],
          "bucketAggs": [
            { "type": "terms", "id": "3", "field": "path", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "min_doc_count": "1" } },
            { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0" } }
          ],
          "timeField": "@timestamp"
        }
      ]
