      "id": 100,
      "panels": []
    },

    {
      "type": "stat",
      "title": "동시 사용자",
      "description": "최근 5분 이내 client_alive heartbeat을 보낸 unique uuid. 지금 서비스에 있는 사람 수.",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:client_alive",
          "metrics": [ { "type": "cardinality", "field": "uuid", "id": "1" } ],
          "bucketAggs": [
            { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },

    {
      "type": "stat",
      "title": "진입 (funnel_started)",
      "description": "최근 1분간 funnel 진입 카운트 — 지금 누가 들어오고 있는가.",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": null } ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:funnel_started",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },

    {
      "type": "stat",
      "title": "완주 (funnel_goal_reached)",
      "description": "최근 1분간 funnel 목표 도달 카운트 — 지금 누가 끝까지 가고 있는가.",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value", "graphMode": "area", "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:funnel_goal_reached",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },

    {
      "type": "gauge",
      "title": "실시간 완주율",
      "description": "최근 15분간 funnel_goal_reached / funnel_started. unit:percentunit 라 비율(0~1)을 자동으로 % 로 표시. 빨강(20%↓) → 주황 → 녹색(50%↑).",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^완주율$/", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "yellow", "value": 0.35 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:funnel_started",
          "alias": "started",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:funnel_goal_reached",
          "alias": "goal",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [ { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } } ],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "Time", "mode": "outer" }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              { "fieldName": "started", "config": { "id": "greater", "options": { "value": 0 } } }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "완주율",
            "mode": "binary",
            "binary": { "left": "goal", "operator": "/", "right": "started" },
            "replaceFields": false
          }
        }
      ]
    },

    {
      "type": "row",
      "title": "📡 유입·채널 분석",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "panels": []
