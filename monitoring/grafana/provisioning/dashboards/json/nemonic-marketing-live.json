    {
      "type": "piechart",
      "title": "유입 채널 분포",
      "description": "최근 5분 landing_source_detected 의 entry_type 분포 — direct / search / social / qr / share / campaign.",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "right", "values": ["value"] }
