      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:landing_source_detected",
          "alias": "{{term metadata.entry_type}}",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            { "type": "terms", "id": "2", "field": "metadata.entry_type", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "missing": "unknown" } }
          ],
          "timeField": "@timestamp"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "컨텐츠별 활성 사용자",
      "description": "client_alive 의 path 별 unique uuid cardinality. content_type 이 비어있어도 path 로 어느 화면에 사람이 있는지.",
