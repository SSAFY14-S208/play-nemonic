      "id": 6,
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 30, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "short"
