    {
      "type": "timeseries",
      "title": "Funnel 활동 (started / goal / abandoned)",
      "description": "08B §11 전환·이탈 — 세 시리즈를 한 화면에 표시해 funnel 통과 vs 이탈 비교. 정확한 funnel 인구 추적은 OpenSearch Dashboards에서 flow_id로 세션 단위 분석.",
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 },
      "id": 36,
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "started" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "goal_reached" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "abandoned" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch" },
          "query": "event_name:funnel_started",
          "alias": "started",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            { "type": "date_histogram", "id": "2", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0" } }
          ],
          "timeField": "@timestamp"
        },
        {
          "refId": "B",
