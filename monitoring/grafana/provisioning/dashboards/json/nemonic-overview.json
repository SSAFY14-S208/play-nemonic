    {
      "type": "timeseries",
      "title": "Nginx 요청 처리율 (req/s)",
      "description": "stub_status 기반 — status별 분리는 vts/lua module 필요. 여기는 전체 처리율과 active connection만.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "rate(nginx_http_requests_total[1m])", "legendFormat": "requests" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Nginx 활성 커넥션",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 6 },
