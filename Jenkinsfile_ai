// ============================================================
// AI Pipeline (ai/dev 브랜치, Registry 기반)
//
// 동작:
// 1. GitLab ai/dev push → Webhook 트리거
// 2. 모더레이션 서버 파일 구조와 비밀 파일 포함 여부 검증
// 3. ai/moderation-server Docker 이미지 빌드
// 4. 로컬 Registry에 push
// 5. infra/dev가 ai 배포 타깃을 지원하면 원격 배포 실행
//
// 주의:
// - 현재 infra/dev의 remote-deploy.sh는 아직 --target ai를 지원하지 않으므로
//   RUN_DEPLOY 기본값은 false입니다.
// - 실제 Google Vision API key는 Jenkinsfile이나 Git에 넣지 않고
//   운영 서버의 /opt/nemonic/shared/.env.prod에만 둡니다.
// - Registry 주소는 호스트 Docker daemon 기준으로 localhost:5000을 사용합니다.
// ============================================================

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'DEPLOY_BASE_DIR',
               defaultValue: '/opt/nemonic',
               description: '호스트 기준 배포 디렉토리')
        booleanParam(name: 'RUN_DEPLOY',
                     defaultValue: false,
                     description: 'infra/dev에 ai 배포 타깃이 추가된 뒤 true로 변경')
        booleanParam(name: 'NOTIFY_MM',
                     defaultValue: true,
                     description: 'Mattermost 알림 전송 여부')
    }

    environment {
        APP_NAME             = 'nemonic'
        COMPOSE_PROJECT_NAME = 'nemonic-prod'
        HOST_BASE_DIR        = "${params.DEPLOY_BASE_DIR}"
        DEPLOY_TARGET        = 'ai'
        REGISTRY_HOST        = 'localhost:5000'
        IMAGE_REPO           = 'nemonic/moderation-server'
        APP_DIR              = 'ai/moderation-server'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.SHORT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.COMMIT_MSG = sh(
                        script: 'git log -1 --pretty=%s',
                        returnStdout: true
                    ).trim()
                    env.COMMIT_AUTHOR = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()
                    env.RELEASE_NAME = "release-ai-${BUILD_NUMBER}-${env.SHORT_SHA}"
                    env.IMAGE_TAG = "${REGISTRY_HOST}/${IMAGE_REPO}:${env.RELEASE_NAME}"
                    env.IMAGE_LATEST = "${REGISTRY_HOST}/${IMAGE_REPO}:latest"
                    echo "Release name: ${env.RELEASE_NAME}"
                    echo "Image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Notify Start') {
            when { expression { params.NOTIFY_MM } }
            steps {
                script {
                    notifyMattermost('started')
                }
            }
        }

        stage('Validate Layout') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "[검증] FastAPI 모더레이션 서버 필수 파일 확인"
                    test -f "${APP_DIR}/Dockerfile"
                    test -f "${APP_DIR}/requirements.txt"
                    test -f "${APP_DIR}/app/main.py"
                    test -f "${APP_DIR}/app/moderation.py"
                    test -f "${APP_DIR}/app/ocr.py"
                    test -f "${APP_DIR}/app/settings.py"
                    test -f "${APP_DIR}/app/schemas.py"

                    echo "[검증] 비밀 파일이 Docker build context에 들어가지 않는지 확인"
                    if [ -f "${APP_DIR}/.env" ]; then
                        echo "[ERROR] ${APP_DIR}/.env 파일이 Jenkins workspace에 있습니다. 비밀 파일은 Git/Jenkins workspace에 두지 마세요." >&2
                        exit 1
                    fi

                    if ! grep -Fxq '.env' "${APP_DIR}/.dockerignore"; then
                        echo "[ERROR] ${APP_DIR}/.dockerignore에 .env 제외 규칙이 없습니다." >&2
                        exit 1
                    fi

                    echo "AI 모더레이션 서버 구조 검증 완료"
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "이미지 빌드: ${IMAGE_TAG}"
                    docker build \
                      -t "${IMAGE_TAG}" \
                      -t "${IMAGE_LATEST}" \
                      "${APP_DIR}"

                    # registry에 누적된 이미지가 많으면 head가 grep의 stdin을 일찍 닫아
                    # pipefail 때문에 false negative가 날 수 있으므로 디버그 출력 실패는 무시합니다.
                    docker images | grep "${IMAGE_REPO}" | head -5 || true
                '''
            }
        }

        stage('Push to Registry') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "Registry push 시작"
                    docker push "${IMAGE_TAG}"
                    docker push "${IMAGE_LATEST}"

                    echo "Registry catalog:"
                    curl -sf http://localhost:5000/v2/_catalog || true
                    echo ""
                    echo "Tags for ${IMAGE_REPO}:"
                    curl -sf "http://localhost:5000/v2/${IMAGE_REPO}/tags/list" || true
                '''
            }
        }

        stage('Deploy') {
            when {
                expression {
                    def branch = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    return params.RUN_DEPLOY && (
                        branch ==~ /(origin\/)?ai\/dev/
                    )
                }
            }
            steps {
                sh '''
                    set -euo pipefail

                    INFRA_DIR="${HOST_BASE_DIR}/infra"
                    if [ ! -d "${INFRA_DIR}" ]; then
                      echo "[ERROR] ${INFRA_DIR} 없음. infra/dev 클론 필요." >&2
                      exit 1
                    fi

                    APP_NAME="${APP_NAME}" \
                    COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME}" \
                    bash "${INFRA_DIR}/deploy/remote-deploy.sh" \
                      --base-dir "${HOST_BASE_DIR}" \
                      --release "${RELEASE_NAME}" \
                      --env-file "${HOST_BASE_DIR}/shared/.env.prod" \
                      --target ai
                '''
            }
        }
    }

    post {
        success {
            echo "AI 배포 파이프라인 성공: ${env.RELEASE_NAME ?: 'N/A'}"
            script {
                if (params.NOTIFY_MM) {
                    notifyMattermost('success')
                }
            }
        }
        failure {
            echo "AI 배포 파이프라인 실패. 로그 확인."
            script {
                if (params.NOTIFY_MM) {
                    notifyMattermost('failure')
                }
            }
        }
        aborted {
            echo "AI 배포 파이프라인 중단됨."
            script {
                if (params.NOTIFY_MM) {
                    notifyMattermost('aborted')
                }
            }
        }
        always {
            sh '''
                docker image prune -f >/dev/null 2>&1 || true
            '''
        }
    }
}

// ============================================================
// Mattermost 알림 함수
// ============================================================
def notifyMattermost(String status) {
    try {
        def color
        def title
        switch (status) {
            case 'started':
                color = '#3399FF'
                title = 'AI 배포 시작'
                break
            case 'success':
                color = '#36A64F'
                title = 'AI 배포 성공'
                break
            case 'failure':
                color = '#D00000'
                title = 'AI 배포 실패'
                break
            case 'aborted':
                color = '#808080'
                title = 'AI 배포 중단'
                break
            default:
                color = '#FFA500'
                title = "AI 배포 ${status}"
        }

        def shortSha   = env.SHORT_SHA ?: 'unknown'
        def commitMsg  = (env.COMMIT_MSG ?: 'N/A').replaceAll('\n', ' ')
        def author     = env.COMMIT_AUTHOR ?: 'unknown'
        def buildNum   = env.BUILD_NUMBER ?: '?'
        def buildUrl   = env.BUILD_URL ?: ''
        def releaseNm  = env.RELEASE_NAME ?: 'N/A'
        def branch     = env.BRANCH_NAME ?: 'ai/dev'

        def durationLine = ''
        if (status != 'started') {
            def duration = currentBuild.durationString.replace(' and counting', '')
            durationLine = " (${duration})"
        }

        def text = """**${title}**

**브랜치**: \\`${branch}\\`
**커밋**: \\`${shortSha}\\` - ${commitMsg}
**작성자**: ${author}
**빌드**: [#${buildNum}](${buildUrl}console)${durationLine}
**릴리스**: \\`${releaseNm}\\`"""

        def payload = groovy.json.JsonOutput.toJson([
            username  : 'Jenkins',
            icon_emoji: ':jenkins:',
            attachments: [[
                color: color,
                text : text
            ]]
        ])

        writeFile file: 'mm-payload.json', text: payload

        withCredentials([string(credentialsId: 'mm-webhook-url', variable: 'WEBHOOK_URL')]) {
            sh '''
                set +e
                curl -sS -X POST \
                  -H "Content-Type: application/json" \
                  --data @mm-payload.json \
                  --max-time 10 \
                  "$WEBHOOK_URL"
                EXIT_CODE=$?
                if [ $EXIT_CODE -ne 0 ]; then
                  echo "[WARN] Mattermost 알림 실패 (exit code: $EXIT_CODE) - 무시하고 계속"
                fi
                rm -f mm-payload.json
                exit 0
            '''
        }
    } catch (Exception e) {
        echo "[WARN] Mattermost 알림 중 에러: ${e.message} (무시하고 계속)"
    }
}
