{
  "policy": {
    "policy_id": "biz-events-policy",
    "description": "Business event lifecycle: hot 7d -> warm 90d -> delete (per observability.md spec).",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {"state_name": "warm", "conditions": {"min_index_age": "7d"}}
        ]
      },
      {
        "name": "warm",
        "actions": [{"force_merge": {"max_num_segments": 1}}],
        "transitions": [
          {"state_name": "delete", "conditions": {"min_index_age": "90d"}}
        ]
      },
      {
        "name": "delete",
        "actions": [{"delete": {}}],
        "transitions": []
      }
    ],
    "ism_template": [
      {"index_patterns": ["biz-events-*"], "priority": 100}
    ]
  }
}
