{
  "index_patterns": ["audit-logs-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "10s",
      "codec": "best_compression",
      "translog.durability": "request",
      "plugins.index_state_management.policy_id": "audit-logs-policy"
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "@timestamp":   { "type": "date" },
        "level":        { "type": "keyword" },
        "service":      { "type": "keyword" },
        "trace_id":     { "type": "keyword" },
        "flow_id":      { "type": "keyword" },
        "session_id":   { "type": "keyword" },
        "uuid":         { "type": "keyword" },
        "event_name":   { "type": "keyword" },
        "content_type": { "type": "keyword" },
        "room_id":      { "type": "keyword" },
        "message":      { "type": "text" },
        "metadata": {
          "properties": {
            "actor_id":    { "type": "keyword" },
            "actor_role":  { "type": "keyword" },
            "actor_ip":    { "type": "ip" },
            "target_type": { "type": "keyword" },
            "target_id":   { "type": "keyword" },
            "action":      { "type": "keyword" },
            "reason":      {
              "type": "text",
              "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } }
            },
            "result":      { "type": "keyword" },
            "before":      { "type": "object", "enabled": false },
            "after":       { "type": "object", "enabled": false }
          }
        },
        "container_id": { "type": "keyword" },
        "log_tag":      { "type": "keyword" },
        "hostname":     { "type": "keyword" },
        "stream":       { "type": "keyword" },
        "tags":         { "type": "keyword" },
        "log_type":     { "type": "keyword" }
      }
    }
  },
  "_meta": {
    "description": "운영자 감사 로그. 영구 보존, dynamic mapping 차단(스키마 폭발 방지). before/after 객체는 인덱싱하지 않고 원문 보관(fields:enabled=false)."
  }
}
