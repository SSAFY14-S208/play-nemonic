{
  "index_patterns": [
    "error-logs-*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "10s",
      "codec": "best_compression",
      "translog.durability": "async",
      "plugins.index_state_management.policy_id": "error-logs-policy"
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "level": {
          "type": "keyword"
        },
        "log_level": {
          "type": "keyword"
        },
        "service": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "trace_id": {
          "type": "keyword"
        },
        "flow_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "uuid": {
          "type": "keyword"
        },
        "event_name": {
          "type": "keyword"
        },
        "content_type": {
          "type": "keyword"
        },
        "room_id": {
          "type": "keyword"
        },
        "prev_zone": {
          "type": "keyword"
        },
        "prev_path": {
          "type": "keyword",
          "ignore_above": 512
        },
        "path": {
          "type": "keyword",
          "ignore_above": 512
        },
        "pid": {
          "type": "long"
        },
        "application": {
          "type": "keyword"
        },
        "thread": {
          "type": "keyword"
        },
        "logger": {
          "type": "keyword"
        },
        "log_message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "message": {
          "type": "text"
        },
        "error": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            },
            "stack": {
              "type": "text",
              "index": false
            }
          }
        },
        "container_id": {
          "type": "keyword"
        },
        "log_tag": {
          "type": "keyword"
        },
        "hostname": {
          "type": "keyword"
        },
        "stream": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "log_type": {
          "type": "keyword"
        },
        "container_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "에러/예외 로그 인덱스. log_level ERROR/FATAL 또는 메시지에 Exception/stack trace 키워드 매칭."
  }
}
