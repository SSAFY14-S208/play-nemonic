{
  "index_patterns": ["biz-events-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "10s",
      "codec": "best_compression",
      "translog.durability": "async",
      "plugins.index_state_management.policy_id": "biz-events-policy"
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp":   { "type": "date" },
        "level":        { "type": "keyword" },
        "service":      { "type": "keyword" },
        "trace_id":     { "type": "keyword" },
        "session_id":   { "type": "keyword" },
        "uuid":         { "type": "keyword" },
        "event_name":   { "type": "keyword" },
        "content_type": { "type": "keyword" },
        "room_id":      { "type": "keyword" },
        "prev_zone":    { "type": "keyword" },
        "message":      { "type": "text" },
        "error": {
          "properties": {
            "type":    { "type": "keyword" },
            "message": { "type": "text" },
            "stack":   { "type": "text", "index": false }
          }
        },
        "metadata": {
          "properties": {
            "round":             { "type": "integer" },
            "canvas_id":         { "type": "keyword" },
            "frame_index":       { "type": "integer" },
            "report_count":      { "type": "integer" },
            "fifo_rank":         { "type": "integer" },
            "gms_latency_ms":    { "type": "long" },
            "retry_count":       { "type": "integer" },
            "participant_count": { "type": "integer" },
            "is_host":           { "type": "boolean" },
            "reconnect_attempt": { "type": "integer" }
          }
        },
        "container_id": { "type": "keyword" },
        "log_tag":      { "type": "keyword" },
        "hostname":     { "type": "keyword" },
        "stream":       { "type": "keyword" },
        "tags":         { "type": "keyword" },
        "log_type":     { "type": "keyword" }
      }
    }
  },
  "_meta": {
    "description": "비즈니스 이벤트 인덱스. observability.md 표준 JSON 스키마 + metadata 명시 매핑."
  }
}
