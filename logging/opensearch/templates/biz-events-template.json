{
  "index_patterns": [
    "biz-events-*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "10s",
      "codec": "best_compression",
      "translog.durability": "async",
      "plugins.index_state_management.policy_id": "biz-events-policy"
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "level": {
          "type": "keyword"
        },
        "service": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "trace_id": {
          "type": "keyword"
        },
        "flow_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "uuid": {
          "type": "keyword"
        },
        "event_name": {
          "type": "keyword"
        },
        "content_type": {
          "type": "keyword"
        },
        "room_id": {
          "type": "keyword"
        },
        "prev_zone": {
          "type": "keyword"
        },
        "prev_path": {
          "type": "keyword",
          "ignore_above": 512
        },
        "path": {
          "type": "keyword",
          "ignore_above": 512
        },
        "funnel_name": {
          "type": "keyword"
        },
        "step_name": {
          "type": "keyword"
        },
        "step_index": {
          "type": "integer"
        },
        "entry_type": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        },
        "error": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            },
            "stack": {
              "type": "text",
              "index": false
            }
          }
        },
        "metadata": {
          "properties": {
            "round": {
              "type": "integer"
            },
            "canvas_id": {
              "type": "keyword"
            },
            "frame_index": {
              "type": "integer"
            },
            "report_count": {
              "type": "integer"
            },
            "fifo_rank": {
              "type": "integer"
            },
            "gms_latency_ms": {
              "type": "long"
            },
            "retry_count": {
              "type": "integer"
            },
            "participant_count": {
              "type": "integer"
            },
            "is_host": {
              "type": "boolean"
            },
            "reconnect_attempt": {
              "type": "integer"
            },
            "referrer": {
              "type": "keyword",
              "ignore_above": 512
            },
            "utm_source": {
              "type": "keyword"
            },
            "utm_medium": {
              "type": "keyword"
            },
            "utm_campaign": {
              "type": "keyword"
            },
            "utm_content": {
              "type": "keyword"
            },
            "utm_term": {
              "type": "keyword",
              "ignore_above": 64
            },
            "viewport": {
              "type": "object",
              "enabled": false
            },
            "platform": {
              "type": "keyword"
            },
            "locale": {
              "type": "keyword"
            },
            "network": {
              "type": "keyword"
            },
            "time_on_page_ms": {
              "type": "long"
            },
            "time_visible_ms": {
              "type": "long"
            },
            "time_in_session_ms": {
              "type": "long"
            },
            "elapsed_ms": {
              "type": "long"
            },
            "depth_percent": {
              "type": "short"
            },
            "modal_id": {
              "type": "keyword"
            },
            "tool_id": {
              "type": "keyword"
            },
            "cta_id": {
              "type": "keyword"
            },
            "goal_name": {
              "type": "keyword"
            },
            "last_step_name": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            },
            "reject_reason": {
              "type": "keyword"
            },
            "room_status": {
              "type": "keyword"
            },
            "exception_type": {
              "type": "keyword"
            },
            "share_type": {
              "type": "keyword"
            },
            "metric_name": {
              "type": "keyword"
            },
            "value": {
              "type": "double"
            }
          }
        },
        "container_id": {
          "type": "keyword"
        },
        "log_tag": {
          "type": "keyword"
        },
        "hostname": {
          "type": "keyword"
        },
        "stream": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "log_type": {
          "type": "keyword"
        },
        "container_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "비즈니스 이벤트 인덱스. observability.md 표준 JSON 스키마 + metadata 명시 매핑."
  }
}
